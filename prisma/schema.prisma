generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  phone           String   @unique
  name            String?
  email           String?
  passwordHash    String?
  role            String   @default("USER") // USER | ADMIN
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED
  walletBalance   Int      @default(0)
  loyaltyPoints   Int      @default(0)
  totalSpent      Int      @default(0)
  referralCode    String   @unique
  referredById    String?
  referredBy      User?    @relation("UserReferrals", fields: [referredById], references: [id])
  referrals       User[]   @relation("UserReferrals")
  preferredLocale String   @default("fa") // fa | en
  tagsJson        String   @default("[]") // JSON string[]
  lastPurchaseAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders             Order[]
  walletTransactions WalletTransaction[]
  tickets            Ticket[]
  ticketMessages     TicketMessage[]
  reviews            ProductReview[]
  crmNotesReceived   CrmNote[]           @relation("CrmTargetUser")
  crmNotesAuthored   CrmNote[]           @relation("CrmAuthorUser")
  notifications      Notification[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameFa        String
  nameEn        String
  descriptionFa String
  descriptionEn String
  icon          String    @default("Sparkles")
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  products      Product[]
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  titleFa         String
  titleEn         String
  shortDescFa     String
  shortDescEn     String
  descriptionFa   String
  descriptionEn   String
  guideFa         String
  guideEn         String
  deliveryType    String          @default("VAULT") // VAULT | UPSTREAM_API | MANUAL
  inputFieldsJson String          @default("[]") // [{ key, labelFa, labelEn, placeholderFa, placeholderEn, required }]
  badgeFa         String?
  badgeEn         String?
  accentColor     String          @default("#6366f1")
  isFeatured      Boolean         @default(false)
  isActive        Boolean         @default(true)
  salesCount      Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  plans   ProductPlan[]
  reviews ProductReview[]
}

model ProductPlan {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  titleFa            String
  titleEn            String
  durationDays       Int?
  priceToman         Int
  priceUsd           Float?
  useUsdRate         Boolean  @default(false)
  pointsReward       Int      @default(25)
  upstreamProviderId String?
  upstreamProvider   UpstreamProvider? @relation(fields: [upstreamProviderId], references: [id])
  upstreamServiceId  String?
  upstreamQuantity   Int      @default(1)
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)

  vaultItems DigitalVaultItem[]
  orderItems OrderItem[]
}

model DigitalVaultItem {
  id            String    @id @default(cuid())
  planId        String
  plan          ProductPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  secretPayload String
  note          String?
  isUsed        Boolean   @default(false)
  usedAt        DateTime?
  orderItemId   String?   @unique
  orderItem     OrderItem? @relation(fields: [orderItemId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([planId, isUsed])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int      @default(5)
  comment    String
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Order {
  id                  String      @id @default(cuid())
  orderNumber         String      @unique
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  status              String      @default("PENDING_PAYMENT") // PENDING_PAYMENT | PROCESSING | COMPLETED | PARTIAL | FAILED | REFUNDED
  paymentMethod       String      @default("GATEWAY") // WALLET | GATEWAY
  paymentStatus       String      @default("UNPAID") // UNPAID | PAID | REFUNDED
  subtotalToman       Int
  tierDiscountToman   Int         @default(0)
  couponDiscountToman Int         @default(0)
  totalToman          Int
  couponCode          String?
  pointsEarned        Int         @default(0)
  gatewayRef          String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  items   OrderItem[]
  tickets Ticket[]
}

model OrderItem {
  id                   String            @id @default(cuid())
  orderId              String
  order                Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  planId               String
  plan                 ProductPlan       @relation(fields: [planId], references: [id])
  productTitleFa       String
  productTitleEn       String
  planTitleFa          String
  planTitleEn          String
  quantity             Int               @default(1)
  unitPriceToman       Int
  totalPriceToman      Int
  deliveryType         String
  customerInputsJson   String            @default("{}")
  deliveredSecret      String?
  fulfillmentStatus    String            @default("PENDING") // PENDING | PROCESSING | DELIVERED | FAILED
  upstreamOrderId      String?
  upstreamResponseJson String?
  virtualNumber        String?
  virtualCountry       String?
  virtualSmsCode       String?
  virtualRequestId     String?
  virtualStatus        String? // WAITING_CODE | CODE_RECEIVED | CANCELED | EXPIRED
  expiresAt            DateTime?
  reminderSent         Boolean           @default(false)

  // Gift Order Fields
  isGift               Boolean           @default(false)
  giftRecipientName    String?
  giftMessage          String?
  giftCode             String?           @unique

  // Warranty & Replacement Claim Fields
  warrantyUntil        DateTime?
  warrantyStatus       String?           // NONE | CLAIMED | REPLACED | REJECTED
  warrantyClaimReason  String?
  warrantyClaimDate    DateTime?
  replacementSecret    String?

  createdAt            DateTime          @default(now())

  vaultItem DigitalVaultItem?
}

model WalletTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int // positive credit, negative debit
  type          String // DEPOSIT | PURCHASE | CASHBACK | REFUND | LOYALTY_REDEEM | REFERRAL_BONUS | ADMIN_ADJUST
  descriptionFa String
  descriptionEn String
  referenceId   String?
  createdAt     DateTime @default(now())
}

model UpstreamProvider {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  baseUrl     String
  apiKey      String
  protocol    String           @default("SMM_PANEL") // SMM_PANEL | FRAGMENT_API | CUSTOM_REST | OZVINOO_CALLINOO | ALTIVOX_AI
  balanceText String?
  isActive    Boolean          @default(true)
  isSandbox   Boolean          @default(true)
  lastSyncAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  plans   ProductPlan[]
  apiLogs UpstreamApiLog[]
}

model UpstreamApiLog {
  id             String           @id @default(cuid())
  providerId     String
  provider       UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  orderItemId    String?
  action         String // SUBMIT_ORDER | CHECK_STATUS | FETCH_SERVICES | TEST_CONNECTION
  requestPayload String
  responseBody   String
  httpStatus     Int
  success        Boolean
  durationMs     Int              @default(0)
  createdAt      DateTime         @default(now())
}

model SmsProviderConfig {
  id                String   @id @default(cuid())
  providerKey       String   @unique // SANDBOX | MELLIPAYAMAK | SMSIR | KAVENEGAR | IPPANEL
  title             String
  apiKey            String   @default("")
  username          String   @default("")
  password          String   @default("")
  senderLine        String   @default("")
  otpPatternCode    String   @default("")
  orderPatternCode  String   @default("")
  expiryPatternCode String   @default("")
  isActive          Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

model SmsLog {
  id                String   @id @default(cuid())
  providerKey       String
  phone             String
  message           String
  templateType      String // OTP | ORDER_COMPLETE | EXPIRY_REMINDER | CRM_CAMPAIGN
  status            String // SENT | FAILED | SANDBOX_LOGGED
  providerMessageId String?
  createdAt         DateTime @default(now())
}

model LoyaltyTier {
  id              String @id @default(cuid())
  key             String @unique // BRONZE | SILVER | GOLD | VIP
  nameFa          String
  nameEn          String
  minPoints       Int
  discountPercent Int    @default(0)
  cashbackPercent Int    @default(0)
  colorHex        String @default("#6366f1")
  sortOrder       Int    @default(0)
}

model CrmNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("CrmTargetUser", fields: [userId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("CrmAuthorUser", fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())
}

model CrmCampaign {
  id             String   @id @default(cuid())
  title          String
  segment        String // ALL | VIP | EXPIRING_SOON | INACTIVE | TELEGRAM_BUYERS
  channel        String   @default("SMS") // SMS | IN_APP
  message        String
  recipientCount Int      @default(0)
  createdAt      DateTime @default(now())
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("PERCENT") // PERCENT | FIXED
  value         Int
  minOrderToman Int       @default(0)
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model Ticket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?
  order        Order?          @relation(fields: [orderId], references: [id])
  subject      String
  category     String          @default("GENERAL") // ORDER | TECHNICAL | PAYMENT | GENERAL
  priority     String          @default("NORMAL") // LOW | NORMAL | HIGH
  status       String          @default("OPEN") // OPEN | ANSWERED | CLOSED
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  isAdmin   Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleFa   String
  titleEn   String
  bodyFa    String
  bodyEn    String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteSetting {
  id                  String   @id @default("default")
  usdToTomanRate      Int      @default(68500)
  siteNameFa          String   @default("دیجی‌ساب")
  siteNameEn          String   @default("DigiSub")
  heroNoticeFa        String   @default("تحویل آنی تلگرام پرمیوم، استارز و اشتراک‌های هوش مصنوعی با اتصال مستقیم API")
  heroNoticeEn        String   @default("Instant delivery for Telegram Premium, Stars & AI subscriptions via direct API")
  pointsPer10kToman   Int      @default(5)
  referralBonusPoints Int      @default(100)

  // Custom Homepage & Hero Customizer
  heroTitleFa         String?  @default("فروشگاه هوشمند اشتراک و اکانت‌های دیجیتال بین‌المللی")
  heroTitleEn         String?  @default("Smart Platform for Digital Subscriptions & Accounts")
  heroSubtitleFa      String?  @default("تحویل آنی تلگرام پرمیوم و استارز از شبکه فرگمنت TON، شماره مجازی اختصاصی و فعال‌سازی اکانت‌های هوش مصنوعی با گارانتی کامل و تخفیف باشگاه مشتریان")
  heroSubtitleEn      String?  @default("Instant delivery for Telegram Premium, Stars via TON Fragment, Virtual Numbers & AI licenses with full warranty.")
  heroCtaTextFa       String?  @default("مشاهده و خرید اشتراک‌ها")
  heroCtaTextEn       String?  @default("Browse Subscriptions")
  heroCtaLink         String?  @default("/store")
  heroBadgeFa         String?  @default("تحویل ۱۰۰٪ اتوماتیک و اتصال مستقیم سرور مادر")
  heroBadgeEn         String?  @default("100% Automated Instant Fulfillment")

  // Announcement Bar (Header top notification)
  announcementActive  Boolean  @default(true)
  announcementTextFa  String?  @default("🔥 تخفیف ویژه ۱۵ درصدی برای اولین خرید شما با کد تخفیف WELCOME15")
  announcementTextEn  String?  @default("🔥 15% Welcome discount on your first order with coupon WELCOME15")
  announcementLink    String?  @default("/store")

  // Social & Contact Details
  supportPhone        String?  @default("021-91000000")
  supportTelegram     String?  @default("DigiSubSupport")
  supportInstagram    String?  @default("digisub_store")

  updatedAt           DateTime @updatedAt
}

model CustomPage {
  id             String   @id @default(cuid())
  slug           String   @unique
  titleFa        String
  titleEn        String
  contentFa      String
  contentEn      String
  isSystemPage   Boolean  @default(false)
  showInFooter   Boolean  @default(true)
  showInHeader   Boolean  @default(false)
  seoTitle       String?
  seoDescription String?
  published      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Article {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  content           String
  excerpt           String?
  coverImage        String?
  author            String   @default("تیم تحریریه دیجی‌ساب")
  category          String   @default("آموزش و مقالات")
  readingTimeMin    Int      @default(5)
  published         Boolean  @default(true)
  views             Int      @default(0)

  // Advanced SEO & Snippet Metadata
  seoTitle          String?
  seoDescription    String?
  focusKeyword      String?
  secondaryKeywords String?
  canonicalUrl      String?
  schemaType        String   @default("Article")
  faqItemsJson      String?
  seoScore          Int      @default(85)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
